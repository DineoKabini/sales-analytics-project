    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "df = pd.read_csv(\"../data/cleaned/clean_train.csv\")\n",
    "\n",
    "sales_by_region = df.groupby(\"Region\")[\"Sales\"].sum()\n",
    "\n",
    "sales_by_region.plot(kind=\"bar\", title=\"Sales by Region\")\n",
    "plt.show()\n"
   ]
  }
